<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tambah Pengguna - DPMP4KB</title>
    
    <link rel="stylesheet" href="assets/css/tambah-pengguna.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght=300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <style>
        .alert-box {
            padding: 12px 16px;
            border-radius: 6px;
            margin-bottom: 20px;
            font-size: 14px;
            display: none;
        }
        .alert-success { background-color: #d1e7dd; color: #0f5132; border: 1px solid #badbcc; }
        .alert-error { background-color: #f8d7da; color: #842029; border: 1px solid #f5c2c7; }
        .btn-submit:disabled { opacity: 0.6; cursor: not-allowed; }
    </style>
</head>
<body>

<div class="form-container">

    <header class="form-header">
        <div class="header-left">
            <h1>Tambah Pengguna</h1>
            <div class="breadcrumb">
                <a href="dashboard.html" style="text-decoration:none; color:inherit;">Dashboard</a> / 
                <a href="pengguna.html" style="text-decoration:none; color:inherit;">Pengguna</a> / 
                <span class="active">Tambah Pengguna</span>
            </div>
        </div>
        <div class="header-right">
            <div class="admin-profile">
                <i class="fa-regular fa-user user-avatar"></i>
                <span class="admin-name">Admin</span>
                <i class="fa-solid fa-chevron-down arrow-down"></i>
            </div>
        </div>
    </header>

    <main class="form-body">
        <div id="alertBox" class="alert-box"></div>

        <form id="formTambahPengguna" novalidate>
            
            <div class="input-group">
                <label for="nama_lengkap">Nama Lengkap <span class="required">*</span></label>
                <input type="text" id="nama_lengkap" name="nama_lengkap" placeholder="Masukkan nama lengkap" required autocomplete="name">
            </div>

            <div class="input-group">
                <label for="no_whatsapp">No WhatsApp <span class="required">*</span></label>
                <input type="tel" id="no_whatsapp" name="no_whatsapp" placeholder="Contoh: 081234567890" pattern="[0-9]{10,15}" required autocomplete="tel">
            </div>

            <div class="input-group">
                <label for="alamat">Alamat <span class="required">*</span></label>
                <textarea id="alamat" name="alamat" rows="6" placeholder="Masukkan alamat lengkap" required></textarea>
            </div>

            <div class="form-footer">
                <div class="footer-left">
                    <a href="pengguna.html" class="btn-back">&lt; Kembali</a>
                </div>
                <div class="footer-right">
                    <button type="button" class="btn-cancel" onclick="window.location.href='pengguna.html'">Batal</button>
                    <button type="submit" id="btnSubmit" class="btn-submit">
                        <span id="btnText">Simpan</span>
                    </button>
                </div>
            </div>

        </form>
    </main>

</div>

<script src="assets/js/tambah-pengguna.js"></script>

</body>
</html>