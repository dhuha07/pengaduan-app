<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Riwayat Percakapan - DPMP4KB</title>
    
    <link rel="stylesheet" href="assets/css/riwayat-percakapan.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <!-- Ganti socket.io lokal ke CDN agar aman saat deploy -->
    <script src="https://cdn.socket.io/4.7.2/socket.io.min.js"></script>
    
    <style>
        .filter-container {
            display: flex;
            gap: 8px;
            padding: 10px 15px;
            background: #ffffff;
            border-bottom: 1px solid #e9ecef;
        }
        .filter-select {
            padding: 8px 12px;
            border-radius: 6px;
            border: 1px solid #ced4da;
            font-family: 'Poppins', sans-serif;
            font-size: 12px;
            outline: none;
            flex: 1;
            background-color: #ffffff !important;
            color: #333333 !important;
        }
        .search-box {
            background-color: #ffffff !important;
            border: 1px solid #ced4da;
            border-radius: 6px;
            padding: 6px 12px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .search-box input {
            border: none;
            outline: none;
            background-color: #ffffff !important;
            color: #333333 !important;
            width: 100%;
            font-family: 'Poppins', sans-serif;
            font-size: 13px;
        }

        .badge-status {
            font-size: 10px;
            padding: 2px 6px;
            border-radius: 4px;
            font-weight: 600;
            margin-left: 5px;
            text-transform: uppercase;
        }
        .status-baru { background: #e3f2fd; color: #0d6efd; }
        .status-diproses { background: #fff3cd; color: #664d03; }
        .status-selesai { background: #d1e7dd; color: #0f5132; }
        
        .chat-actions {
            display: flex;
            gap: 8px;
            align-items: center;
        }
        .action-btn {
            padding: 8px 12px;
            border-radius: 6px;
            border: none;
            cursor: pointer;
            font-family: 'Poppins', sans-serif;
            font-size: 12px;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 6px;
            text-decoration: none;
        }
        .btn-wa { background-color: #25D366; color: white; }
        .btn-pdf { background-color: #dc3545; color: white; }
        .btn-print { background-color: #6c757d; color: white; }
        
        .chat-bubble {
            max-width: 70%;
            margin-bottom: 12px;
            padding: 10px 14px;
            border-radius: 10px;
            font-size: 13px;
            line-height: 1.4;
            position: relative;
            word-wrap: break-word;
        }
        .user-bubble {
            background-color: #f1f3f5;
            align-self: flex-start;
            border-bottom-left-radius: 2px;
            color: #333;
        }
        .admin-bubble {
            background-color: #d1e7dd;
            color: #0f5132;
            align-self: flex-end;
            margin-left: auto;
            border-bottom-right-radius: 2px;
        }
        .chat-sender {
            font-weight: 700;
            font-size: 11px;
            margin-bottom: 4px;
        }
        .chat-time {
            font-size: 10px;
            color: #6c757d;
            text-align: right;
            margin-top: 4px;
        }
        .chat-item {
            padding: 12px 15px;
            border-bottom: 1px solid #e9ecef;
            cursor: pointer;
            transition: background 0.2s;
        }
        .chat-item:hover, .chat-item.active {
            background-color: #e9ecef;
        }

        @media print {
            body * { visibility: hidden; }
            #printArea, #printArea * { visibility: visible; }
            #printArea { position: absolute; left: 0; top: 0; width: 100%; }
        }
    </style>
</head>
<body>

<div class="container">
    <aside class="sidebar" id="sidebar">
        <div class="logo">
            <img src="assets/images/logo-magelang.png" alt="Logo">
            <div class="logo-text">
                <h2>DPMP4KB</h2>
                <span>KOTA MAGELANG</span>
            </div>
        </div>

        <nav class="nav-menu">
            <a href="dashboard.html" class="menu">
                <i class="fa-solid fa-house"></i>
                <span>Dashboard</span>
            </a>
            <a href="daftar-pengaduan.html" class="menu">
                <i class="fa-regular fa-file-lines"></i>
                <span>Daftar Pengaduan</span>
            </a>
            <a href="riwayat-percakapan.html" class="menu active">
                <i class="fa-regular fa-message"></i>
                <span>Riwayat Percakapan</span>
            </a>
            <a href="laporan.html" class="menu">
                <i class="fa-regular fa-file"></i>
                <span>Laporan</span>
            </a>
            <a href="pengguna.html" class="menu">
                <i class="fa-regular fa-user"></i>
                <span>Pengguna</span>
            </a>
        </nav>

        <a href="index.html" class="logout">
            <i class="fa-solid fa-right-from-bracket"></i>
            <span>Keluar</span>
        </a>
    </aside>

    <main class="content">
        <div class="page-header">
            <div class="header-left">
                <button class="hamburger" id="toggleSidebar">
                    <i class="fa-solid fa-bars"></i>
                </button>
                <div>
                    <h1>Riwayat Percakapan</h1>
                    <div class="breadcrumb">Dashboard / Riwayat Percakapan</div>
                </div>
            </div>

            <div class="search-box">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" id="searchInput" placeholder="Cari nama pelapor atau no laporan...">
            </div>
        </div>

        <div class="chat-wrapper" style="display: flex; height: calc(100vh - 160px); background: #fff; border-radius: 8px; border: 1px solid #e9ecef; overflow: hidden;">
            <div style="display: flex; flex-direction: column; width: 350px; border-right: 1px solid #e9ecef;">
                <div class="filter-container">
                    <select id="filterStatus" class="filter-select" onchange="filterChats()">
                        <option value="">Semua Status</option>
                        <option value="baru">Baru</option>
                        <option value="diproses">Diproses</option>
                        <option value="selesai">Selesai</option>
                    </select>
                    <select id="filterKasus" class="filter-select" onchange="filterChats()">
                        <option value="">Semua Kasus</option>
                        <option value="KDRT Fisik">KDRT Fisik</option>
                        <option value="Kekerasan Anak">Kekerasan Anak</option>
                        <option value="Perkawinan Anak">Perkawinan Anak</option>
                    </select>
                </div>
                
                <div class="chat-list" id="chatList" style="flex: 1; overflow-y: auto;"></div>
            </div>

            <div class="chat-detail" id="chatDetail" style="flex: 1; display: flex; flex-direction: column;">
                <div class="chat-header" style="padding: 15px 20px; border-bottom: 1px solid #e9ecef; display: flex; justify-content: space-between; align-items: center;">
                    <div class="chat-header-left" style="display: flex; align-items: center; gap: 12px;">
                        <div class="avatar" style="width: 40px; height: 40px; background: #e9ecef; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                            <i class="fa-regular fa-user"></i>
                        </div>
                        <div>
                            <h3 id="chatName" style="margin: 0; font-size: 15px;">Pilih Laporan <span id="chatStatusHeader"></span></h3>
                            <small id="chatCase" style="color: #6c757d;">-</small>
                        </div>
                    </div>
                    
                    <div class="chat-actions">
                        <a href="#" id="waBtn" target="_blank" class="action-btn btn-wa">
                            <i class="fa-brands fa-whatsapp"></i> WhatsApp
                        </a>
                        <button onclick="exportToPDF()" class="action-btn btn-pdf">
                            <i class="fa-regular fa-file-pdf"></i> PDF
                        </button>
                        <button onclick="printBeritaAcara()" class="action-btn btn-print">
                            <i class="fa-solid fa-print"></i> Berita Acara
                        </button>
                        <a href="#" id="detailBtn" class="action-btn" style="background: #0d6efd; color: white;">Detail</a>
                    </div>
                </div>

                <div class="chat-body" id="chatBody" style="flex: 1; padding: 20px; overflow-y: auto; display: flex; flex-direction: column;"></div>

                <div class="chat-footer" style="padding: 15px; border-top: 1px solid #e9ecef; display: flex; gap: 10px;">
                    <input type="text" id="messageInput" placeholder="Tulis balasan..." style="flex: 1; padding: 10px 14px; border: 1px solid #ced4da; border-radius: 6px; outline: none; background: #fff; color: #333;">
                    <button class="send-btn" id="btnSend" onclick="sendMessage()" style="padding: 10px 20px; background: #198754; color: white; border: none; border-radius: 6px; cursor: pointer;">Kirim</button>
                </div>
            </div>
        </div>
    </main>
</div>

<div id="printArea" style="display: none; padding: 40px; font-family: Arial, sans-serif; color: black;">
    <div style="text-align: center; border-bottom: 3px double #000; padding-bottom: 10px; margin-bottom: 20px;">
        <h3 style="margin: 0; text-transform: uppercase;">Pemerintah Kota Magelang</h3>
        <h2 style="margin: 5px 0; text-transform: uppercase;">DPMP4KB</h2>
        <p style="margin: 0; font-size: 12px;">Jl. Jend. Gatot Soebroto No. 123, Kota Magelang</p>
    </div>
    <h3 style="text-align: center; text-decoration: underline; text-transform: uppercase;">BERITA ACARA PERCAKAPAN PENGADUAN</h3>
    <p style="text-align: center; font-size: 13px; margin-top: -10px;">Nomor Dokumen: <span id="bapNo"></span></p>
    <br>
    <table style="width: 100%; border-collapse: collapse; margin-bottom: 20px;">
        <tr><td style="width: 150px; padding: 4px 0;">Nama Pelapor</td><td>: <strong id="bapNama"></strong></td></tr>
        <tr><td style="padding: 4px 0;">Jenis Masalah</td><td>: <span id="bapKasus"></span></td></tr>
        <tr><td style="padding: 4px 0;">Status Penanganan</td><td>: <span id="bapStatus"></span></td></tr>
        <tr><td style="padding: 4px 0;">Tanggal Cetak</td><td>: <span id="bapTanggal"></span></td></tr>
    </table>
    <h4 style="border-bottom: 1px solid #000; padding-bottom: 5px;">LOG TRANSKRIP PERCAKAPAN:</h4>
    <div id="bapLog" style="font-size: 12px; line-height: 1.6;"></div>
</div>

<script>
// Konfigurasi API Base URL untuk Deploy Publik
const API_BASE_URL = window.location.origin;

let allReports = [];
let currentMessages = [];
let selectedReport = null;
let socket = null;

if (typeof io !== 'undefined') {
    try {
        socket = io(API_BASE_URL);
    } catch(e) {
        console.warn("Socket.io tidak dapat terhubung:", e);
    }
}

function escapeHTML(str) {
    if (str === null || str === undefined) return '';
    return String(str).replace(/[&<>'"]/g, 
        tag => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[tag] || tag)
    );
}

document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('searchInput');
    const filterStatus = document.getElementById('filterStatus');
    const filterKasus = document.getElementById('filterKasus');

    if (searchInput) searchInput.value = '';
    if (filterStatus) filterStatus.value = '';
    if (filterKasus) filterKasus.value = '';

    const sidebar = document.getElementById("sidebar");
    const toggleBtn = document.getElementById("toggleSidebar");
    if (toggleBtn && sidebar) {
        toggleBtn.addEventListener("click", () => sidebar.classList.toggle("collapsed"));
    }

    if (searchInput) searchInput.addEventListener('input', filterChats);

    const messageInput = document.getElementById('messageInput');
    if (messageInput) {
        messageInput.addEventListener('keypress', (e) => {
            if (e.key === 'Enter') sendMessage();
        });
    }

    loadSidebarList();
});

if (socket) {
    socket.on('pesan_baru', (data) => {
        if (selectedReport && parseInt(selectedReport.id, 10) === parseInt(data.id_pengaduan, 10)) {
            appendSingleMessage(data);
        } else {
            loadSidebarList();
        }
    });
}

async function loadSidebarList() {
    const listContainer = document.getElementById('chatList');
    if (!listContainer) return;
    
    listContainer.innerHTML = '<p style="padding:15px; text-align:center; color:#6c757d;">Memuat data...</p>';

    try {
        const res = await fetch(`${API_BASE_URL}/api/pengaduan`);
        if (!res.ok) throw new Error(`HTTP Error Status: ${res.status}`);
        
        const result = await res.json();
        allReports = Array.isArray(result) ? result : (result.data || []);

        if (allReports.length > 0) {
            renderSidebar(allReports);
            if (!selectedReport) selectReport(allReports[0].id);
        } else {
            listContainer.innerHTML = '<p style="padding:15px; text-align:center; color:#6c757d;">Tidak ada data pengaduan.</p>';
        }
    } catch (err) {
        console.error('Gagal memuat pengaduan:', err);
        listContainer.innerHTML = '<p style="padding:15px; text-align:center; color:red;">Gagal memuat data dari server.</p>';
    }
}

function renderSidebar(data) {
    const listContainer = document.getElementById('chatList');
    if (!listContainer) return;

    if (!data || data.length === 0) {
        listContainer.innerHTML = '<p style="padding:15px; text-align:center; color:#6c757d;">Tidak ada data cocok.</p>';
        return;
    }

    listContainer.innerHTML = data.map(item => {
        const statusText = item.status_validasi || item.status || 'Baru';
        const statusLower = String(statusText).toLowerCase();
        const statusClass = statusLower.includes('selesai') ? 'status-selesai' :
                            statusLower.includes('proses') ? 'status-diproses' : 'status-baru';

        return `
            <div class="chat-item ${selectedReport && selectedReport.id === item.id ? 'active' : ''}" onclick="selectReport(${item.id})">
                <div style="display:flex; justify-content:space-between; align-items:center;">
                    <strong style="font-size:13px; color:#333;">${escapeHTML(item.nama_pelapor || item.nama || 'Anonim')}</strong>
                    <span class="badge-status ${statusClass}">${escapeHTML(statusText)}</span>
                </div>
                <div style="font-size:11px; color:#6c757d; margin-top:3px;">#LP${item.id} - ${escapeHTML(item.kategori_kasus || item.kategori || 'Umum')}</div>
            </div>
        `;
    }).join('');
}

function filterChats() {
    const searchQuery = (document.getElementById('searchInput')?.value || '').trim().toLowerCase();
    const statusQuery = (document.getElementById('filterStatus')?.value || '').trim().toLowerCase();
    const kasusQuery = (document.getElementById('filterKasus')?.value || '').trim().toLowerCase();

    if (!searchQuery && !statusQuery && !kasusQuery) {
        renderSidebar(allReports);
        return;
    }

    const filtered = allReports.filter(item => {
        const nama = String(item.nama_pelapor || item.nama || '').toLowerCase();
        const nomorWa = String(item.nomor_wa || item.no_hp || '').toLowerCase();
        const idStr = String(item.id || '');
        const status = String(item.status_validasi || item.status || '').toLowerCase();
        const kasus = String(item.kategori_kasus || item.kategori || '').toLowerCase();

        const matchSearch = !searchQuery || nama.includes(searchQuery) || nomorWa.includes(searchQuery) || idStr.includes(searchQuery);
        const matchStatus = !statusQuery || status.includes(statusQuery);
        const matchKasus = !kasusQuery || kasus.includes(kasusQuery);

        return matchSearch && matchStatus && matchKasus;
    });

    renderSidebar(filtered);
}

async function selectReport(reportId) {
    selectedReport = allReports.find(r => r.id === reportId);
    if (!selectedReport) return;

    renderSidebar(allReports);

    document.getElementById('chatName').childNodes[0].nodeValue = `${selectedReport.nama_pelapor || selectedReport.nama || 'Anonim'} `;
    document.getElementById('chatStatusHeader').innerText = `(${selectedReport.status_validasi || selectedReport.status || 'Baru'})`;
    document.getElementById('chatCase').innerText = `${selectedReport.kategori_kasus || selectedReport.kategori || 'Umum'} | #LP${selectedReport.id}`;
    document.getElementById('detailBtn').href = `detail-pengaduan.html?id=${selectedReport.id}`;

    const waNum = selectedReport.nomor_wa || selectedReport.no_hp;
    if (waNum) {
        const cleanPhone = String(waNum).replace(/[^0-9]/g, '');
        const formattedPhone = cleanPhone.startsWith('0') ? '62' + cleanPhone.slice(1) : cleanPhone;
        document.getElementById('waBtn').href = `https://wa.me/${formattedPhone}`;
    } else {
        document.getElementById('waBtn').href = '#';
    }

    loadChatMessages(reportId);
}

async function loadChatMessages(reportId) {
    const chatContainer = document.getElementById('chatBody');
    if (!chatContainer) return;

    chatContainer.innerHTML = '<p style="text-align:center; color:#6c757d;">Memuat percakapan...</p>';

    try {
        const res = await fetch(`${API_BASE_URL}/api/percakapan/${reportId}`);
        if (!res.ok) throw new Error(`HTTP Error Status: ${res.status}`);
        
        const result = await res.json();
        const msgs = Array.isArray(result) ? result : (result.data || []);

        if (msgs.length === 0) {
            currentMessages = [];
            chatContainer.innerHTML = '<div style="margin:auto; color:#6c757d; text-align:center;">Belum ada riwayat percakapan. Ketik pesan di bawah untuk membalas.</div>';
            return;
        }

        currentMessages = msgs;
        chatContainer.innerHTML = '';
        currentMessages.forEach(msg => appendSingleMessage(msg, false));
        chatContainer.scrollTop = chatContainer.scrollHeight;

    } catch (err) {
        console.error('Error:', err);
        chatContainer.innerHTML = '<p style="color:red; text-align:center;">Gagal memuat percakapan.</p>';
    }
}

function appendSingleMessage(msg, autoScroll = true) {
    const chatContainer = document.getElementById('chatBody');
    if (!chatContainer) return;

    if (chatContainer.children.length === 1 && !chatContainer.children[0].classList.contains('chat-bubble')) {
        chatContainer.innerHTML = '';
    }

    const isAdmin = msg.pengirim === 'admin' || msg.is_admin === 1 || msg.is_admin === true;
    const dateVal = msg.created_at || msg.tanggal || new Date();
    const senderName = isAdmin ? 'Admin DPMP4KB' : escapeHTML(selectedReport?.nama_pelapor || selectedReport?.nama || 'Pelapor');

    const bubbleHTML = `
        <div class="chat-bubble ${isAdmin ? 'admin-bubble' : 'user-bubble'}">
            <div class="chat-sender">${senderName}</div>
            <div class="chat-text">${escapeHTML(msg.pesan || msg.message)}</div>
            <div class="chat-time">${new Date(dateVal).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'})}</div>
        </div>
    `;

    chatContainer.insertAdjacentHTML('beforeend', bubbleHTML);
    if (autoScroll) chatContainer.scrollTop = chatContainer.scrollHeight;
}

async function sendMessage() {
    const input = document.getElementById('messageInput');
    const btnSend = document.getElementById('btnSend');
    const pesan = input.value.trim();

    if (!pesan || !selectedReport) return;

    input.disabled = true;
    btnSend.disabled = true;

    try {
        const res = await fetch(`${API_BASE_URL}/api/percakapan`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id_pengaduan: selectedReport.id, pesan })
        });

        const result = await res.json();
        if (res.ok && (result.success || result.status === 'ok')) {
            input.value = '';
            loadChatMessages(selectedReport.id);
        } else {
            alert(result.message || 'Gagal mengirim pesan.');
        }
    } catch (err) {
        console.error(err);
        alert('Gagal mengirim pesan.');
    } finally {
        input.disabled = false;
        btnSend.disabled = false;
        input.focus();
    }
}

function printBeritaAcara() {
    if (!selectedReport) return alert('Pilih percakapan terlebih dahulu.');

    document.getElementById('bapNo').innerText = `BAP/DPMP4KB/${selectedReport.id}/${new Date().getFullYear()}`;
    document.getElementById('bapNama').innerText = selectedReport.nama_pelapor || selectedReport.nama || 'Anonim';
    document.getElementById('bapKasus').innerText = selectedReport.kategori_kasus || selectedReport.kategori || '-';
    document.getElementById('bapStatus').innerText = selectedReport.status_validasi || selectedReport.status || 'Baru';
    document.getElementById('bapTanggal').innerText = new Date().toLocaleDateString('id-ID');

    const bapLog = document.getElementById('bapLog');
    if (currentMessages.length === 0) {
        bapLog.innerHTML = '<p><em>Tidak ada riwayat pesan.</em></p>';
    } else {
        bapLog.innerHTML = currentMessages.map(m => {
            const sender = (m.pengirim === 'admin' || m.is_admin) ? 'Admin' : escapeHTML(selectedReport.nama_pelapor || selectedReport.nama || 'Pelapor');
            return `<p><strong>[${new Date(m.created_at || m.tanggal || new Date()).toLocaleString('id-ID')}] ${sender}:</strong> ${escapeHTML(m.pesan || m.message)}</p>`;
        }).join('');
    }

    window.print();
}

function exportToPDF() {
    if (!selectedReport) return alert('Pilih percakapan terlebih dahulu.');

    const { jsPDF } = window.jspdf;
    const doc = new jsPDF();

    doc.setFontSize(16);
    doc.text(`Transkrip Percakapan #LP${selectedReport.id}`, 14, 20);
    doc.setFontSize(10);
    doc.text(`Pelapor: ${selectedReport.nama_pelapor || selectedReport.nama || 'Anonim'}`, 14, 28);
    doc.text(`Kasus: ${selectedReport.kategori_kasus || selectedReport.kategori || '-'}`, 14, 34);

    let y = 45;
    currentMessages.forEach((m) => {
        const isAdmin = m.pengirim === 'admin' || m.is_admin;
        const sender = isAdmin ? 'Admin' : (selectedReport.nama_pelapor || selectedReport.nama || 'Pelapor');
        const text = `[${new Date(m.created_at || new Date()).toLocaleTimeString()}] ${sender}: ${m.pesan || m.message}`;
        
        const lines = doc.splitTextToSize(text, 180);
        const blockHeight = lines.length * 6;

        if (y + blockHeight > 280) {
            doc.addPage();
            y = 20;
        }

        doc.text(lines, 14, y);
        y += blockHeight + 2;
    });

    doc.save(`Percakapan_LP${selectedReport.id}.pdf`);
}
</script>

</body>
</html>